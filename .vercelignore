.freebuff
/truthcourt
# Solidity sources are not needed at runtime — but this must stay anchored to
# the repo root. An unanchored "contracts/" also matches public/contracts/, and
# those JSON artifacts are what the browser downloads to deploy from, so
# excluding them silently disabled the Deploy page and the 5-in-1 runner.
/contracts
/genlayer-contracts
/docs
*.log
build_errors.txt
*.tsbuildinfo
.git/
# Local-only artefacts (screenshots, motion frames, stale export dirs) — big
# and never served by Next (which only serves /public). Keep them out of the
# CLI upload so a deploy stays a few MB instead of hundreds.
.capture/
/tmp-motion
/shots
/out
/out-slim
/output-premium
